#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <2 1>;
            bindings = <&kp ESC>;
        };

        combo_bang {
            bindings = <&kp EXCLAMATION>;
            key-positions = <0 10>;
        };

        combo_at {
            bindings = <&kp AT_SIGN>;
            key-positions = <1 11>;
        };

        combo_hash {
            bindings = <&kp HASH>;
            key-positions = <2 12>;
        };

        combo_dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <3 13>;
        };

        combo_prct {
            bindings = <&kp LC(PERCENT)>;
            key-positions = <4 14>;
        };

        combo_caret {
            bindings = <&kp CARET>;
            key-positions = <5 15>;
        };

        combo_ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <6 16>;
        };

        combo_asterix {
            bindings = <&kp ASTERISK>;
            key-positions = <7 17>;
        };

        combo_bslsh {
            bindings = <&kp BACKSLASH>;
            key-positions = <8 18>;
        };

        combo_sqt {
            bindings = <&kp SQT>;
            key-positions = <9 19>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        combo_lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <7 8>;
        };

        combo_rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <8 9>;
        };

        combo_lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <17 18>;
        };

        combo_rparen {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 19>;
        };

        combo_lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 27>;
        };

        combo_rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            // ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            // ┃     B     ┃     L     ┃     D     ┃     C     ┃     V     ┃   ┃     J     ┃     Y     ┃     O     ┃     U     ┃     ,     ┃
            // ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            // ┃     N     ┃     R     ┃     T     ┃     S     ┃     G     ┃   ┃     P     ┃     H     ┃     A     ┃     E     ┃     I     ┃
            // ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            // ┃     X     ┃     Q     ┃     M     ┃     W     ┃     Z     ┃   ┃     K     ┃     F     ┃     '     ┃     ;     ┃     .     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    SPC    ┃    TAB    ┃   ┃   ENTER   ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
&kp Q             &kp W           &kp E       &kp R        &kp T      &kp Y          &kp U        &kp I            &kp O            &kp P
&kp A             &mt LEFT_GUI S  &mt LALT D  &mt LCTRL F  &kp G      &kp H          &mt RCTRL J  &mt RIGHT_ALT K  &mt RIGHT_GUI E  &lt 2 SEMICOLON
&mt LEFT_SHIFT Z  &kp X           &kp C       &kp V        &kp B      &kp N          &kp M        &kp COMMA        &kp PERIOD       &mt SLASH RIGHT_SHIFT
                                              &sl 1        &kp SPACE  &kp BACKSPACE  &lt 3 ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp RIGHT LEFT_ARROW>;
        };

        num_layer {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NAV";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            // ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            // ┃           ┃           ┃           ┃           ┃           ┃   ┃           ┃           ┃   P UP    ┃           ┃           ┃
            // ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            // ┃           ┃           ┃           ┃           ┃           ┃   ┃   LEFT    ┃   DOWN    ┃    UP     ┃   RIGHT   ┃           ┃
            // ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            // ┃           ┃           ┃           ┃           ┃           ┃   ┃           ┃  P DOWN   ┃           ┃           ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃   ┃    DEL    ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
&trans  &trans    &kp UP    &trans     &trans  &kp PAGE_UP    &kp HOME          &kp UP_ARROW  &kp END     &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &kp PAGE_DOWN  &kp LEFT          &kp UP        &kp RIGHT   &trans
&trans  &trans    &trans    &trans     &trans  &trans         &kp C_PLAY_PAUSE  &kp C_PREV    &kp C_NEXT  &trans
                            &trans     &trans  &trans         &trans
            >;
        };

        adjust_layer {
            bindings = <
&kp F1          &kp F2        &kp F3        &kp F4            &kp F5  &kp F6  &kp F7      &kp F8         &kp F9         &kp F10
&kp F11         &sk LEFT_GUI  &sk LEFT_ALT  &sk LEFT_CONTROL  &trans  &trans  &sk RCTRL   &sk RIGHT_ALT  &sk RIGHT_GUI  &kp F12
&sk LEFT_SHIFT  &trans        &trans        &trans            &trans  &trans  &bt BT_CLR  &bt BT_PRV     &bt BT_NXT     &sk RIGHT_SHIFT
                                            &trans            &trans  &trans  &trans
            >;
        };
    };
};
